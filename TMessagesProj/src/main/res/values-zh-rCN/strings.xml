    <string name="AdFreeSettingsHeader">自定义功能</string>
    <string name="AdFreeTitle">免广告</string>
    <string name="AdFreeInfo">隐藏 Telegram 官方赞助消息、视频广告和搜索推广。</string>
    <string name="DownloadSpeedBoostTitle">下载加速</string>
    <string name="DownloadSpeedBoostModeOff">关闭</string>
    <string name="DownloadSpeedBoostModeAverage">加速</string>
    <string name="DownloadSpeedBoostModeExtreme">极限</string>
    <string name="DownloadSpeedBoostOptionOff">关闭（跟随官方）</string>
    <string name="DownloadSpeedBoostOptionAverage">加速（推荐，512 KiB × 8）</string>
    <string name="DownloadSpeedBoostOptionExtreme">极限（1 MiB × 12）</string>
    <string name="DownloadSpeedBoostInfo">提高客户端的下载分片大小和并发请求数，不能解除 Telegram 服务端限速。极限模式会增加耗电和内存占用；设置对新下载或取消后重新下载的任务生效。</string>
    <string name="PrivacyControlsHeader">本地隐私控制</string>
    <string name="AntiDeleteTitle">保留已撤回消息</string>
    <string name="AntiDeleteInfo">云聊天中其他人删除消息时保留本地副本；自己主动删除仍按原逻辑执行。</string>
    <string name="KeepDeletedMediaTitle">保留已撤回媒体</string>
    <string name="KeepDeletedMediaInfo">消息被撤回时，将已经下载的媒体复制到应用私有归档。</string>
    <string name="RepeatViewOnceTitle">重复查看一次性媒体</string>
    <string name="RepeatViewOnceInfo">首次查看后，仍可重复打开收到的一次性照片、视频、语音和圆视频，并可保存到本地或作为副本发送。</string>
    <string name="ProtectedCopySaveTitle">复制和保存受保护内容</string>
    <string name="ProtectedCopySaveInfo">为普通云聊天中的受保护内容显示本地复制与保存操作。</string>
    <string name="ProtectedSendCopyTitle">将受保护内容作为副本发送</string>
    <string name="ProtectedSendCopyInfo">重新上传本地文件，不携带原转发来源；发送前需要先下载源文件。</string>
    <string name="ProtectedSendCopyMenu">作为副本发送</string>
    <string name="DisableFlagSecureTitle">允许截图和录屏</string>
    <string name="DisableFlagSecureInfo">解除受保护聊天、一次性媒体、快拍等界面的系统截图/录屏限制。</string>
    <string name="LocalArchiveRetentionTitle">本地归档保留时间</string>
